rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Rede global de segurança (nega tudo por padrão)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Primitivas globais de validação e identidade
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidCompositeId(id) {
      return id is string && id.size() >= 3 && id.size() <= 260 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'ruanferreira1342008@gmail.com'
      );
    }

    // 3. Validadores de esquema (sincronizados com firebase-blueprint.json)
    function isValidUserProfile(data, uid) {
      return data.keys().hasAll([
          'id', 'displayName', 'campus', 'course', 'year', 'bio', 'avatarUrl',
          'showCampus', 'showCourse', 'showStats', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'displayName', 'campus', 'course', 'year', 'bio', 'avatarUrl',
          'showCampus', 'showCourse', 'showStats', 'createdAt', 'updatedAt'
        ]) &&
        data.id == uid &&
        isValidId(data.id) &&
        data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 80 &&
        data.campus is string && data.campus.size() >= 2 && data.campus.size() <= 100 &&
        data.course is string && data.course.size() >= 2 && data.course.size() <= 120 &&
        data.year is string && data.year.size() <= 40 &&
        data.bio is string && data.bio.size() <= 300 &&
        data.avatarUrl is string && data.avatarUrl.size() <= 500 &&
        data.showCampus is bool &&
        data.showCourse is bool &&
        data.showStats is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserPrivate(data, uid) {
      return data.keys().hasAll([
          'id', 'email', 'institutionalDomainVerified', 'acceptedTerms',
          'acceptedTermsAt', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'email', 'institutionalDomainVerified', 'acceptedTerms',
          'acceptedTermsAt', 'createdAt', 'updatedAt'
        ]) &&
        data.id == uid &&
        isValidId(data.id) &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 180 &&
        data.institutionalDomainVerified is bool &&
        data.acceptedTerms is bool && data.acceptedTerms == true &&
        data.acceptedTermsAt is timestamp &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSubject(data, subjectId) {
      return data.keys().hasAll(['id', 'name', 'area', 'active', 'order']) &&
        data.keys().hasOnly(['id', 'name', 'area', 'active', 'order']) &&
        data.id == subjectId &&
        isValidId(data.id) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
        data.area is string && data.area.size() >= 2 && data.area.size() <= 80 &&
        data.active is bool &&
        data.order is int && data.order >= 0 && data.order <= 1000;
    }

    function isValidTagsList(tags) {
      return tags is list &&
        tags.size() <= 5 &&
        (tags.size() == 0 || (tags[0] is string && tags[0].size() >= 1 && tags[0].size() <= 30)) &&
        (tags.size() < 2 || (tags[1] is string && tags[1].size() >= 1 && tags[1].size() <= 30)) &&
        (tags.size() < 3 || (tags[2] is string && tags[2].size() >= 1 && tags[2].size() <= 30)) &&
        (tags.size() < 4 || (tags[3] is string && tags[3].size() >= 1 && tags[3].size() <= 30)) &&
        (tags.size() < 5 || (tags[4] is string && tags[4].size() >= 1 && tags[4].size() <= 30));
    }

    function isValidQuestion(data, qId) {
      return data.keys().hasAll([
          'id', 'authorId', 'authorName', 'authorCampus', 'authorCourse', 'authorAvatarUrl',
          'title', 'body', 'codeSnippet', 'referenceUrl', 'subjectId', 'subjectName',
          'campusId', 'courseId', 'tags', 'status', 'visibility', 'answersCount',
          'lastAnswerId', 'lastRemovedAnswerId', 'isEdited', 'createdAt', 'updatedAt', 'lastActivityAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'authorId', 'authorName', 'authorCampus', 'authorCourse', 'authorAvatarUrl',
          'title', 'body', 'codeSnippet', 'referenceUrl', 'subjectId', 'subjectName',
          'campusId', 'courseId', 'tags', 'status', 'visibility', 'answersCount',
          'lastAnswerId', 'lastRemovedAnswerId', 'isEdited', 'createdAt', 'updatedAt', 'lastActivityAt'
        ]) &&
        data.id == qId &&
        isValidId(data.id) &&
        isValidId(data.authorId) &&
        data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 80 &&
        data.authorCampus is string && data.authorCampus.size() <= 100 &&
        data.authorCourse is string && data.authorCourse.size() <= 120 &&
        data.authorAvatarUrl is string && data.authorAvatarUrl.size() <= 500 &&
        data.title is string && data.title.size() >= 10 && data.title.size() <= 150 &&
        data.body is string && data.body.size() >= 20 && data.body.size() <= 5000 &&
        data.codeSnippet is string && data.codeSnippet.size() <= 2500 &&
        data.referenceUrl is string && data.referenceUrl.size() <= 400 &&
        (data.referenceUrl == '' || data.referenceUrl.matches('^https://.*')) &&
        isValidId(data.subjectId) &&
        data.subjectName is string && data.subjectName.size() >= 2 && data.subjectName.size() <= 80 &&
        data.campusId is string && data.campusId.size() <= 100 &&
        data.courseId is string && data.courseId.size() <= 120 &&
        isValidTagsList(data.tags) &&
        data.status in ['open', 'resolved'] &&
        data.visibility in ['community', 'removed'] &&
        data.answersCount is int && data.answersCount >= 0 &&
        data.lastAnswerId is string && data.lastAnswerId.size() <= 128 &&
        data.lastRemovedAnswerId is string && data.lastRemovedAnswerId.size() <= 128 &&
        data.isEdited is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.lastActivityAt is timestamp;
    }

    function isValidAnswer(data, aId) {
      return data.keys().hasAll([
          'id', 'questionId', 'authorId', 'authorName', 'authorCampus', 'authorCourse',
          'authorAvatarUrl', 'body', 'codeSnippet', 'helpfulCount', 'visibility',
          'isEdited', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'questionId', 'authorId', 'authorName', 'authorCampus', 'authorCourse',
          'authorAvatarUrl', 'body', 'codeSnippet', 'helpfulCount', 'visibility',
          'isEdited', 'createdAt', 'updatedAt'
        ]) &&
        data.id == aId &&
        isValidId(data.id) &&
        isValidId(data.questionId) &&
        isValidId(data.authorId) &&
        data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 80 &&
        data.authorCampus is string && data.authorCampus.size() <= 100 &&
        data.authorCourse is string && data.authorCourse.size() <= 120 &&
        data.authorAvatarUrl is string && data.authorAvatarUrl.size() <= 500 &&
        data.body is string && data.body.size() >= 10 && data.body.size() <= 5000 &&
        data.codeSnippet is string && data.codeSnippet.size() <= 2500 &&
        data.helpfulCount is int && data.helpfulCount >= 0 &&
        data.visibility in ['community', 'removed'] &&
        data.isEdited is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidComplement(data, cId) {
      return data.keys().hasAll([
          'id', 'questionId', 'answerId', 'authorId', 'authorName',
          'authorRoleLabel', 'body', 'visibility', 'isEdited', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'questionId', 'answerId', 'authorId', 'authorName',
          'authorRoleLabel', 'body', 'visibility', 'isEdited', 'createdAt', 'updatedAt'
        ]) &&
        data.id == cId &&
        isValidId(data.id) &&
        isValidId(data.questionId) &&
        isValidId(data.answerId) &&
        isValidId(data.authorId) &&
        data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 80 &&
        data.authorRoleLabel in ['Autor da pergunta', 'Autor da resposta'] &&
        data.body is string && data.body.size() >= 5 && data.body.size() <= 2000 &&
        data.visibility in ['community', 'removed'] &&
        data.isEdited is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidHelpfulVote(data, voteId) {
      return data.keys().hasAll(['id', 'userId', 'answerId', 'questionId', 'answerAuthorId', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'answerId', 'questionId', 'answerAuthorId', 'createdAt']) &&
        data.id == voteId &&
        isValidCompositeId(data.id) &&
        isValidId(data.userId) &&
        isValidId(data.answerId) &&
        isValidId(data.questionId) &&
        isValidId(data.answerAuthorId) &&
        voteId == (data.answerId + '_' + data.userId) &&
        data.createdAt is timestamp;
    }

    function isValidBookmark(data, bId) {
      return data.keys().hasAll(['id', 'userId', 'questionId', 'questionTitle', 'subjectName', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'questionId', 'questionTitle', 'subjectName', 'createdAt']) &&
        data.id == bId &&
        isValidCompositeId(data.id) &&
        isValidId(data.userId) &&
        isValidId(data.questionId) &&
        bId == (data.userId + '_' + data.questionId) &&
        data.questionTitle is string && data.questionTitle.size() >= 1 && data.questionTitle.size() <= 150 &&
        data.subjectName is string && data.subjectName.size() >= 2 && data.subjectName.size() <= 80 &&
        data.createdAt is timestamp;
    }

    function isValidNotification(data, nId) {
      return data.keys().hasAll([
          'id', 'recipientId', 'actorId', 'actorName', 'type',
          'relatedQuestionId', 'relatedQuestionTitle', 'relatedAnswerId', 'isRead', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'recipientId', 'actorId', 'actorName', 'type',
          'relatedQuestionId', 'relatedQuestionTitle', 'relatedAnswerId', 'isRead', 'readAt', 'createdAt'
        ]) &&
        data.id == nId &&
        isValidId(data.id) &&
        isValidId(data.recipientId) &&
        isValidId(data.actorId) &&
        data.actorName is string && data.actorName.size() >= 2 && data.actorName.size() <= 80 &&
        data.type in ['new_answer', 'new_complement', 'helpful_answer'] &&
        isValidId(data.relatedQuestionId) &&
        data.relatedQuestionTitle is string && data.relatedQuestionTitle.size() >= 1 && data.relatedQuestionTitle.size() <= 150 &&
        data.relatedAnswerId is string && data.relatedAnswerId.size() <= 128 &&
        data.isRead is bool &&
        (!('readAt' in data) || data.readAt is timestamp) &&
        data.createdAt is timestamp;
    }

    function isValidReport(data, rId) {
      return data.keys().hasAll([
          'id', 'reporterId', 'targetType', 'targetId', 'targetExcerpt',
          'reason', 'description', 'status', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'reporterId', 'targetType', 'targetId', 'targetExcerpt',
          'reason', 'description', 'status', 'createdAt', 'reviewedBy', 'reviewedAt'
        ]) &&
        data.id == rId &&
        isValidCompositeId(data.id) &&
        isValidId(data.reporterId) &&
        data.targetType in ['question', 'answer', 'complement', 'profile'] &&
        isValidId(data.targetId) &&
        data.targetExcerpt is string && data.targetExcerpt.size() >= 1 && data.targetExcerpt.size() <= 200 &&
        data.reason in ['harassment', 'spam', 'inappropriate', 'pii_exposed', 'off_topic'] &&
        data.description is string && data.description.size() <= 600 &&
        data.status in ['pending', 'reviewed', 'dismissed', 'action_taken'] &&
        data.createdAt is timestamp &&
        (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 128)) &&
        (!('reviewedAt' in data) || data.reviewedAt is timestamp);
    }

    // 4. Coleções e regras por operação

    // Perfis públicos acadêmicos (sem PII)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        (isOwner(userId) || isAdmin()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'campus', 'course', 'year', 'bio', 'avatarUrl',
          'showCampus', 'showCourse', 'showStats', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Dados privados (e-mail, aceite de termos) - PII isolado
    match /user_private/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserPrivate(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isSignedIn() &&
        isValidId(userId) &&
        isValidUserPrivate(incoming(), userId) &&
        (isOwner(userId) || isAdmin()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().acceptedTermsAt == existing().acceptedTermsAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'email', 'institutionalDomainVerified', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Registro de administradores (somente leitura própria ou admin; nunca gravável pelo cliente)
    match /admins/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow write: if false;
    }

    // Catálogo de disciplinas
    match /subjects/{subjectId} {
      allow get: if isSignedIn() && isValidId(subjectId);
      allow list: if isSignedIn() && resource.data.active == true;
      allow create: if isAdmin() && isValidId(subjectId) && isValidSubject(incoming(), subjectId);
      allow update: if isAdmin() && isValidId(subjectId) && isValidSubject(incoming(), subjectId) &&
        incoming().id == existing().id;
      allow delete: if isAdmin() && isValidId(subjectId);
    }

    // Perguntas
    match /questions/{questionId} {
      allow get: if isSignedIn() && isValidId(questionId) && (existing().visibility == 'community' || isOwner(existing().authorId) || isAdmin());
      allow list: if isSignedIn() && resource.data.visibility == 'community';
      allow create: if isVerifiedUser() &&
        isValidId(questionId) &&
        isValidQuestion(incoming(), questionId) &&
        incoming().authorId == request.auth.uid &&
        incoming().status == 'open' &&
        incoming().visibility == 'community' &&
        incoming().answersCount == 0 &&
        incoming().lastAnswerId == '' &&
        incoming().lastRemovedAnswerId == '' &&
        incoming().isEdited == false &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        incoming().lastActivityAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(questionId) &&
        isValidQuestion(incoming(), questionId) &&
        incoming().id == existing().id &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        (
          // Ação 1: Autor edita conteúdo da própria pergunta
          (
            isOwner(existing().authorId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'body', 'codeSnippet', 'referenceUrl', 'subjectId', 'subjectName',
              'campusId', 'courseId', 'tags', 'isEdited', 'updatedAt', 'lastActivityAt',
              'authorName', 'authorCampus', 'authorCourse', 'authorAvatarUrl'
            ]) &&
            incoming().isEdited == true &&
            incoming().updatedAt == request.time &&
            incoming().lastActivityAt == request.time
          ) ||
          // Ação 2: Autor marca como resolvida ou reabre a pergunta
          (
            isOwner(existing().authorId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'lastActivityAt']) &&
            incoming().status in ['open', 'resolved'] &&
            incoming().updatedAt == request.time &&
            incoming().lastActivityAt == request.time
          ) ||
          // Ação 3: Novo envio de resposta (writeBatch atômico via existsAfter)
          (
            existing().status == 'open' &&
            existing().visibility == 'community' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['answersCount', 'lastAnswerId', 'lastActivityAt']) &&
            incoming().answersCount == existing().answersCount + 1 &&
            incoming().lastActivityAt == request.time &&
            isValidId(incoming().lastAnswerId) &&
            incoming().lastAnswerId != existing().lastAnswerId &&
            existsAfter(/databases/$(database)/documents/answers/$(incoming().lastAnswerId)) &&
            getAfter(/databases/$(database)/documents/answers/$(incoming().lastAnswerId)).data.questionId == questionId &&
            getAfter(/databases/$(database)/documents/answers/$(incoming().lastAnswerId)).data.authorId == request.auth.uid
          ) ||
          // Ação 4: Remoção de resposta pelo autor da resposta (writeBatch atômico)
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['answersCount', 'lastRemovedAnswerId']) &&
            incoming().answersCount == existing().answersCount - 1 &&
            existing().answersCount >= 1 &&
            isValidId(incoming().lastRemovedAnswerId) &&
            exists(/databases/$(database)/documents/answers/$(incoming().lastRemovedAnswerId)) &&
            !existsAfter(/databases/$(database)/documents/answers/$(incoming().lastRemovedAnswerId)) &&
            get(/databases/$(database)/documents/answers/$(incoming().lastRemovedAnswerId)).data.questionId == questionId &&
            (
              get(/databases/$(database)/documents/answers/$(incoming().lastRemovedAnswerId)).data.authorId == request.auth.uid ||
              isAdmin()
            )
          ) ||
          // Ação 5: Moderação por administrador
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['visibility', 'status', 'updatedAt']) &&
            incoming().updatedAt == request.time
          )
        );
      allow delete: if isVerifiedUser() &&
        isValidId(questionId) &&
        (isOwner(existing().authorId) || isAdmin());
    }

    // Respostas
    match /answers/{answerId} {
      allow get: if isSignedIn() && isValidId(answerId) && (existing().visibility == 'community' || isOwner(existing().authorId) || isAdmin());
      allow list: if isSignedIn() && resource.data.visibility == 'community';
      allow create: if isVerifiedUser() &&
        isValidId(answerId) &&
        isValidAnswer(incoming(), answerId) &&
        incoming().authorId == request.auth.uid &&
        incoming().helpfulCount == 0 &&
        incoming().visibility == 'community' &&
        incoming().isEdited == false &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/questions/$(incoming().questionId)) &&
        get(/databases/$(database)/documents/questions/$(incoming().questionId)).data.visibility == 'community' &&
        get(/databases/$(database)/documents/questions/$(incoming().questionId)).data.status == 'open';
      allow update: if isVerifiedUser() &&
        isValidId(answerId) &&
        isValidAnswer(incoming(), answerId) &&
        incoming().id == existing().id &&
        incoming().questionId == existing().questionId &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        (
          // Ação 1: Autor edita a própria resposta
          (
            isOwner(existing().authorId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['body', 'codeSnippet', 'isEdited', 'updatedAt']) &&
            incoming().isEdited == true &&
            incoming().updatedAt == request.time
          ) ||
          // Ação 2: Outro estudante marca como útil (writeBatch atômico com helpful_votes)
          (
            existing().visibility == 'community' &&
            existing().authorId != request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['helpfulCount']) &&
            incoming().helpfulCount == existing().helpfulCount + 1 &&
            !exists(/databases/$(database)/documents/helpful_votes/$(answerId + '_' + request.auth.uid)) &&
            existsAfter(/databases/$(database)/documents/helpful_votes/$(answerId + '_' + request.auth.uid))
          ) ||
          // Ação 3: Estudante remove sua marcação de útil (writeBatch atômico)
          (
            existing().visibility == 'community' &&
            existing().helpfulCount >= 1 &&
            incoming().diff(existing()).affectedKeys().hasOnly(['helpfulCount']) &&
            incoming().helpfulCount == existing().helpfulCount - 1 &&
            exists(/databases/$(database)/documents/helpful_votes/$(answerId + '_' + request.auth.uid)) &&
            !existsAfter(/databases/$(database)/documents/helpful_votes/$(answerId + '_' + request.auth.uid))
          ) ||
          // Ação 4: Moderação administrativa
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['visibility', 'updatedAt']) &&
            incoming().updatedAt == request.time
          )
        );
      allow delete: if isVerifiedUser() &&
        isValidId(answerId) &&
        (
          isOwner(existing().authorId) ||
          isAdmin() ||
          (
            exists(/databases/$(database)/documents/questions/$(existing().questionId)) &&
            get(/databases/$(database)/documents/questions/$(existing().questionId)).data.authorId == request.auth.uid
          )
        );
    }

    // Complementações vinculadas às respostas
    match /complements/{complementId} {
      allow get: if isSignedIn() && isValidId(complementId) && (existing().visibility == 'community' || isOwner(existing().authorId) || isAdmin());
      allow list: if isSignedIn() && resource.data.visibility == 'community';
      allow create: if isVerifiedUser() &&
        isValidId(complementId) &&
        isValidComplement(incoming(), complementId) &&
        incoming().authorId == request.auth.uid &&
        incoming().visibility == 'community' &&
        incoming().isEdited == false &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/questions/$(incoming().questionId)) &&
        exists(/databases/$(database)/documents/answers/$(incoming().answerId)) &&
        get(/databases/$(database)/documents/answers/$(incoming().answerId)).data.questionId == incoming().questionId &&
        (
          (
            get(/databases/$(database)/documents/answers/$(incoming().answerId)).data.authorId == request.auth.uid &&
            incoming().authorRoleLabel == 'Autor da resposta'
          ) ||
          (
            get(/databases/$(database)/documents/questions/$(incoming().questionId)).data.authorId == request.auth.uid &&
            incoming().authorRoleLabel == 'Autor da pergunta'
          )
        );
      allow update: if isVerifiedUser() &&
        isValidId(complementId) &&
        isValidComplement(incoming(), complementId) &&
        incoming().id == existing().id &&
        incoming().questionId == existing().questionId &&
        incoming().answerId == existing().answerId &&
        incoming().authorId == existing().authorId &&
        incoming().authorRoleLabel == existing().authorRoleLabel &&
        incoming().createdAt == existing().createdAt &&
        (
          (
            isOwner(existing().authorId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['body', 'isEdited', 'updatedAt']) &&
            incoming().isEdited == true &&
            incoming().updatedAt == request.time
          ) ||
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['visibility', 'updatedAt']) &&
            incoming().updatedAt == request.time
          )
        );
      allow delete: if isVerifiedUser() &&
        isValidId(complementId) &&
        (
          isOwner(existing().authorId) ||
          isAdmin() ||
          (
            exists(/databases/$(database)/documents/questions/$(existing().questionId)) &&
            get(/databases/$(database)/documents/questions/$(existing().questionId)).data.authorId == request.auth.uid
          )
        );
    }

    // Marcações de resposta útil (id determinístico: answerId_userId)
    match /helpful_votes/{voteId} {
      allow get: if isSignedIn() && isValidCompositeId(voteId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isVerifiedUser() &&
        isValidCompositeId(voteId) &&
        isValidHelpfulVote(incoming(), voteId) &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/answers/$(incoming().answerId)) &&
        get(/databases/$(database)/documents/answers/$(incoming().answerId)).data.authorId != request.auth.uid;
      allow delete: if isVerifiedUser() &&
        isValidCompositeId(voteId) &&
        (isOwner(existing().userId) || isAdmin());
    }

    // Favoritos / Perguntas salvas (id determinístico: userId_questionId)
    match /bookmarks/{bookmarkId} {
      allow get: if isSignedIn() && isValidCompositeId(bookmarkId) && isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isVerifiedUser() &&
        isValidCompositeId(bookmarkId) &&
        isValidBookmark(incoming(), bookmarkId) &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/questions/$(incoming().questionId));
      allow delete: if isVerifiedUser() &&
        isValidCompositeId(bookmarkId) &&
        (isOwner(existing().userId) || isAdmin());
    }

    // Notificações
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isValidId(notificationId) && (isOwner(existing().recipientId) || isAdmin());
      allow list: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if isVerifiedUser() &&
        isValidId(notificationId) &&
        isValidNotification(incoming(), notificationId) &&
        incoming().actorId == request.auth.uid &&
        incoming().recipientId != request.auth.uid &&
        incoming().isRead == false &&
        !('readAt' in incoming()) &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/questions/$(incoming().relatedQuestionId));
      allow update: if isVerifiedUser() &&
        isValidId(notificationId) &&
        isValidNotification(incoming(), notificationId) &&
        isOwner(existing().recipientId) &&
        incoming().id == existing().id &&
        incoming().recipientId == existing().recipientId &&
        incoming().actorId == existing().actorId &&
        incoming().type == existing().type &&
        incoming().relatedQuestionId == existing().relatedQuestionId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'readAt']) &&
        incoming().isRead == true &&
        incoming().readAt == request.time;
      allow delete: if isVerifiedUser() && isValidId(notificationId) && (isOwner(existing().recipientId) || isAdmin());
    }

    // Denúncias e moderação
    match /reports/{reportId} {
      allow get: if isSignedIn() && isValidCompositeId(reportId) && (isOwner(existing().reporterId) || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.reporterId == request.auth.uid);
      allow create: if isVerifiedUser() &&
        isValidCompositeId(reportId) &&
        isValidReport(incoming(), reportId) &&
        incoming().reporterId == request.auth.uid &&
        incoming().status == 'pending' &&
        !('reviewedBy' in incoming()) &&
        !('reviewedAt' in incoming()) &&
        incoming().createdAt == request.time;
      allow update: if isAdmin() &&
        isValidCompositeId(reportId) &&
        isValidReport(incoming(), reportId) &&
        incoming().id == existing().id &&
        incoming().reporterId == existing().reporterId &&
        incoming().targetType == existing().targetType &&
        incoming().targetId == existing().targetId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt']) &&
        incoming().reviewedBy == request.auth.uid &&
        incoming().reviewedAt == request.time;
      allow delete: if isAdmin() && isValidCompositeId(reportId);
    }
  }
}
